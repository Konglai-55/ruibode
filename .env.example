PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DB_PATH=data/app.db
# 生产环境首次启动必填；管理员密码至少 12 位。
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 邮件方案一：接收 {to, subject, text, html} JSON 的邮件服务 Webhook。
EMAIL_WEBHOOK_URL=
# 邮件方案二：腾讯企业邮箱 SMTP。SMTP_PASS 使用邮箱后台生成的 SMTP 授权码，不是登录密码；IMAP 只用于收信。
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=noreply@shanghairoboteducation.cn
SMTP_PASS=
SMTP_FROM=noreply@shanghairoboteducation.cn
SMTP_FROM_NAME=上海瑞卜德教育赛事报名平台
